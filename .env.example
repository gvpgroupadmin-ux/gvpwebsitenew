# =============================================================================
# GVP Solar Energy - Production & Deployment Environment Variables
# =============================================================================
#
# When deploying to Vercel:
# Add these variables under Project Settings -> Environment Variables.
#
# Default credentials configured for admin access:
# URL: https://your-domain.vercel.app/cfladmin
# Email: info.gvpsolar@gmail.com
# Password: Cflhouse@124.

# Administrator Login Email
ADMIN_EMAIL="info.gvpsolar@gmail.com"

# Administrator Login Password (case-sensitive)
ADMIN_PASSWORD="Cflhouse@124."

# Secret key used for signing session tokens (HMAC-SHA256)
SESSION_SECRET="gvp-solar-production-session-auth-token-key-2026"

# -----------------------------------------------------------------------------
# OPTIONAL: Persistent Cloud Storage (Vercel KV / Upstash Redis)
# -----------------------------------------------------------------------------
# By default, leads are securely stored in serverless storage (/tmp/leads.json
# on Vercel and .data/leads.json in local dev).
# If you connect Vercel KV or Upstash Redis, provide these for multi-region sync:
#
# KV_REST_API_URL="https://your-upstash-redis.upstash.io"
# KV_REST_API_TOKEN="your_upstash_redis_token"
